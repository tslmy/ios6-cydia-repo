#!/bin/sh
# Runs after dpkg has deleted our file, so the stock method can be moved back.
M=/usr/lib/apt/methods/https

case "$1" in
remove|purge|disappear)
    if dpkg-divert --list "$M" 2>/dev/null | grep -q "by apt-https-curl"; then
        dpkg-divert --package apt-https-curl --rename --remove "$M"
    fi
    ;;
esac
exit 0
